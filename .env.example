# aios-console configuration. Copy to .env.local and fill in.

# Base URL of the aios backend (the FastAPI server).
# Default when running aios locally on its default port: http://localhost:8090
# (aios defaults to 8080 — we use 8090 to avoid colliding with other local
# OpenAI-compatible model servers, which commonly grab 8080.)
AIOS_URL=http://localhost:8090

# Bearer token — the SAME minted account key as AIOS_API_KEY in aios's own
# .env (printed once by `aios migrate` on a fresh database; do not invent a
# value — a made-up key 401s every request). The console proxies every
# upstream request with this key; it never reaches the browser.
AIOS_API_KEY=replace-me

# Operator password for the console itself. STRONGLY recommended: every
# request through this console carries the full-privilege AIOS_API_KEY, so
# anyone who can reach the port can read all sessions and memory and act as
# the assistant's operator. With it set, all pages and /api/aios/* require
# login. Leave empty ONLY for localhost-only use (`pnpm start` binds
# 127.0.0.1 by default; `pnpm start:exposed` binds all interfaces — put TLS
# + this password in front before doing that).
CONSOLE_PASSWORD=

# NOTE: model provider keys (OPENAI_API_KEY, ANTHROPIC_API_KEY,
# OPENROUTER_API_KEY, AIOS_TAVILY_API_KEY, OPENAI_API_BASE, etc.) DO NOT
# belong here. They configure the aios backend (the process that calls
# LiteLLM), not this console. Put them in aios/.env instead.
