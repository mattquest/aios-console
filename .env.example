# aios-console configuration. Copy to .env.local and fill in.

# Base URL of the aios backend (the FastAPI server).
# Default when running aios locally on its default port: http://localhost:8090
# (aios defaults to 8080 — we use 8090 to avoid colliding with other local
# OpenAI-compatible model servers, which commonly grab 8080.)
AIOS_URL=http://localhost:8090

# Bearer token — must match AIOS_API_KEY in aios's own .env. The console
# proxies every upstream request with this key; it never reaches the browser.
# Generate with: openssl rand -hex 32
AIOS_API_KEY=replace-me

# NOTE: model provider keys (OPENAI_API_KEY, ANTHROPIC_API_KEY,
# OPENROUTER_API_KEY, AIOS_TAVILY_API_KEY, OPENAI_API_BASE, etc.) DO NOT
# belong here. They configure the aios backend (the process that calls
# LiteLLM), not this console. Put them in aios/.env instead.
